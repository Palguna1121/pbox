# Copy to .env and fill in real values. Never commit .env.

# Database (compose.yaml exposes PostgreSQL on host port 5433)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/pbox?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-run-openssl-rand-base64-32"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Public base URL for metadata, sitemap, share links and QR codes
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Local media storage; mount a persistent volume here in Docker (default: ./storage)
STORAGE_DIR="/var/lib/pbox/storage"

# Booth hardware bridge (scripts/booth-agent.mjs). Leave BOOTH_AGENT_URL empty to disable.
BOOTH_AGENT_URL="http://127.0.0.1:7788"
BOOTH_AGENT_TOKEN="change-me-shared-secret"
# Set to "true" to let guests without an account send prints to the booth printer
BOOTH_PUBLIC_PRINT="false"

# Read by the booth agent itself
BOOTH_AGENT_PORT="7788"
BOOTH_SIMULATE="1"
# CUPS queue name; empty uses the CUPS default printer
BOOTH_PRINTER=""
