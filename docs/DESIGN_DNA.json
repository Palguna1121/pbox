{
  "design_system": {
    "source": "src/app/globals.css (Tailwind v4 @theme)",
    "themes": {
      "arcade_night": { "default": true, "background": "#0b0820", "foreground": "#f5efe0", "primary": "#ffd23f", "accent": "#ff3d7f", "ring": "#3ef0ff", "border": "#4a4088", "ink": "#000000" },
      "arcade_day": { "background": "#fff6e2", "foreground": "#1a1238", "primary": "#d1105a", "accent": "#ffc400", "ring": "#0a7f99", "border": "#1a1238", "ink": "#1a1238" }
    },
    "typography": {
      "pixel_label": "Press Start 2P, short uppercase only, 0.5-0.75rem",
      "display": "Pixelify Sans Variable, headings, weight 700",
      "mono": "VT323, numbers and scores, >= 1.125rem",
      "body": "Geist Sans"
    },
    "shape": { "radius": "0.25rem", "border_width": "2px", "shadow": "hard offset ink 2/4/7px, no blur" },
    "components": ["shadcn/Radix primitives restyled", "KaraUI motion components via @karaui registry", "arcade Logo/PageIntro"]
  },
  "design_style": {
    "direction": "arcade cabinet / CRT / game cartridge, readable first",
    "copy": "Indonesian, direct, honest; arcade phrases only in short labels (INSERT COIN, STAGE, LEVEL)",
    "layout": "max-w-7xl, grid background, stacked sections with 2px separators, mobile single column"
  },
  "visual_effects": {
    "allowed": ["scanline overlay", "blinking REC dot", "marquee ticker", "countdown digits", "camera flash", "one-time reveal", "press/lift buttons"],
    "reduced_motion": "global CSS clamps animation/transition; motion/react useReducedMotion removes translation",
    "avoid": ["autoplay video", "parallax", "scroll hijack", "glow on body text"]
  }
}
